DB_USERNAME=tvoj_usernam
DB_PASSWORD=tvoj_password
DB_URL=jdbc:mysql://localhost:3306/tvoja_baza?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DDL_AUTO=update
SEED_ENABLED=true

# Postavi sopstveni nasumicni JWT kljuc od najmanje 32 bajta.
JWT_SECRET=
JWT_TRAJANJE=PT1H
CORS_ORIGINS=http://localhost:3000

# Licni GitHub username ili organizacija kojoj pripadaju privatni repoi rokova.
GITHUB_OWNER=
# Fine-grained token: samo odabrani repoi, Contents: read/write, Metadata: read.
GITHUB_TOKEN=
